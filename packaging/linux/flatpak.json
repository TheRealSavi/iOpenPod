{
  "app-id": "io.github.therealsavi.iOpenPod",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "iOpenPod",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=dri",
    "--share=network",
    "--filesystem=home",
    "--filesystem=/media",
    "--filesystem=/run/media",
    "--filesystem=/mnt",
    "--filesystem=/run/udev:ro",
    "--system-talk-name=org.freedesktop.UDisks2",
    "--own-name=org.mpris.MediaPlayer2.iOpenPod"
  ],
  "modules": [{
    "name": "iopenpod",
    "buildsystem": "simple",
    "build-commands": ["cp -a . /app/"],
    "sources": [{"type": "dir", "path": "../../build/linux-root"}]
  }]
}
