#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct Particle {
    vec4 position_life;
    vec4 velocity_seed;
};

layout(std140, binding = 0) uniform FieldState {
    mat4 uViewProjection;
    vec4 uTime;
    vec4 uMusic;
    vec4 uHarmony;
    vec4 uSpectrum;
    vec4 uLayers;
    vec4 uStructure;
    vec4 uSpatial;
    vec4 uCameraRight;
    vec4 uCameraUp;
    vec4 uCameraPosition;
    vec4 uCameraForward;
    vec4 uAttractor0;
    vec4 uAttractor1;
    vec4 uAttractor2;
    vec4 uAttractor3;
    vec4 uWave0;
    vec4 uWave1;
    vec4 uWave2;
    vec4 uWave3;
    vec4 uWaveAmplitude;
    vec4 uWaveCharacter;
    vec4 uScene;
    vec4 uSceneTuning;
    vec4 uSceneMotion0;
    vec4 uSceneMotion1;
    vec4 uViewport;
    vec4 uFeedback;
    vec4 uMotionPhase;
    vec4 uFlowPhase;
    vec4 uMusicPhase;
    vec4 uAccentPhase;
};

layout(std430, binding = 1) readonly buffer PreviousParticles {
    Particle previousParticles[];
};

layout(std430, binding = 2) writeonly buffer NextParticles {
    Particle nextParticles[];
};

float hash11(float value)
{
    return fract(sin(value * 127.1 + 311.7) * 43758.5453123);
}

vec3 hash31(float value)
{
    return fract(sin(vec3(value, value + 17.0, value + 43.0) *
        vec3(127.1, 269.5, 419.2)) * 43758.5453123);
}

vec3 curlField(vec3 point, float time)
{
    float scale = mix(0.46, 1.42, uSpectrum.x);
    float evolution = 0.055 + 0.12 * uMusic.x;
    vec3 q = point * scale + vec3(
        time * evolution,
        -time * evolution * 0.79,
        time * evolution * 0.57
    );
    float sectionAngle = 6.2831853 *
        (uStructure.z * 0.17 + uStructure.y * 0.055);
    mat2 sectionTurn = mat2(
        cos(sectionAngle), -sin(sectionAngle),
        sin(sectionAngle), cos(sectionAngle)
    );
    q.xz = sectionTurn * q.xz;
    vec3 a = vec3(
        sin(q.y * 1.37 + cos(q.z * 0.71)),
        sin(q.z * 1.53 + cos(q.x * 0.83)),
        sin(q.x * 1.29 + cos(q.y * 0.91))
    );
    vec3 b = vec3(
        cos(q.z * 1.11 - q.y * 0.47),
        cos(q.x * 0.97 - q.z * 0.53),
        cos(q.y * 1.07 - q.x * 0.59)
    );
    return normalize(a - b + vec3(0.0001));
}

vec3 attractorForce(vec3 point, vec4 attractor)
{
    vec3 delta = attractor.xyz - point;
    float distanceSquared = dot(delta, delta) + 0.22;
    vec3 direction = delta * inversesqrt(distanceSquared);
    float magnitude = attractor.w / distanceSquared;
    vec3 axis = normalize(vec3(0.31, 0.83, 0.46));
    vec3 orbit = cross(direction, axis) * abs(attractor.w) * uMusic.z /
        (0.8 + distanceSquared);
    return direction * magnitude + orbit * 0.42;
}

vec3 waveForce(vec3 point, vec4 wave, float amplitude)
{
    if (amplitude <= 0.0001 || wave.w < 0.0) {
        return vec3(0.0);
    }
    vec3 delta = point - wave.xyz;
    float distanceFromOrigin = length(delta) + 0.0001;
    float signedDistance = distanceFromOrigin - wave.w;
    float shell = exp(-abs(signedDistance) * 4.8);
    float interference = cos(signedDistance * 8.0);
    return delta / distanceFromOrigin * amplitude * shell * interference * 5.2;
}

void main()
{
    uint index = gl_GlobalInvocationID.x;
    uint particleCount = uint(uTime.z + 0.5);
    if (index >= particleCount) {
        return;
    }

    Particle particle = previousParticles[index];
    vec3 position = particle.position_life.xyz;
    vec3 velocity = particle.velocity_seed.xyz;
    float life = particle.position_life.w;
    float seed = particle.velocity_seed.w;
    float deltaTime = clamp(uTime.y, 0.0, 0.0333333);

    vec3 curl = curlField(position, uTime.x);
    vec3 force = curl * (0.16 + 1.34 * uMusic.z + 0.84 * uLayers.x);
    force += attractorForce(position, uAttractor0);
    force += attractorForce(position, uAttractor1);
    force += attractorForce(position, uAttractor2);
    force += attractorForce(position, uAttractor3);
    force += waveForce(position, uWave0, uWaveAmplitude.x);
    force += waveForce(position, uWave1, uWaveAmplitude.y);
    force += waveForce(position, uWave2, uWaveAmplitude.z);
    force += waveForce(position, uWave3, uWaveAmplitude.w);

    float radius = length(position);
    force -= position * max(0.0, radius - 5.8) * 0.62;
    force -= position * (0.010 + 0.055 * uLayers.w);
    float beat = 0.5 + 0.5 * cos(6.2831853 * uSpatial.z);
    force += normalize(position + vec3(0.001)) *
        (uStructure.x * 0.72 + beat * uHarmony.z * uLayers.y * 0.16);
    force += vec3(uSpatial.x * (0.08 + uSpatial.y * 0.22), 0.0, 0.0);
    vec3 vocalFlow = vec3(
        sin(position.y * 1.7 + uTime.x * 0.31),
        0.55 + 0.35 * cos(position.x * 1.2 - uTime.x * 0.19),
        cos(position.z * 1.4 + uTime.x * 0.23)
    );
    force += vocalFlow * uLayers.z * (0.10 + 0.14 * uMusic.x);
    float microTime = uTime.x * 18.0;
    float microCell = floor(microTime);
    float microBlend = smoothstep(0.0, 1.0, fract(microTime));
    vec3 microDirection = mix(
        hash31(seed + microCell),
        hash31(seed + microCell + 1.0),
        microBlend
    ) * 2.0 - 1.0;
    force += microDirection * (uMusic.w + uSpectrum.y + uLayers.y) *
        (0.09 + 0.19 * hash11(seed));
    force += normalize(position + vec3(0.001)) * uSpatial.w * 0.24;

    velocity += force * deltaTime;
    float drag = 0.20 + 0.24 * uHarmony.y - 0.08 * uMusic.x;
    drag += uSpectrum.z * 0.08 - uSpatial.y * 0.05;
    velocity *= exp(-deltaTime * max(0.08, drag));
    float maximumSpeed = 1.0 + 2.7 * uMusic.x + 1.5 * uMusic.w;
    maximumSpeed += 1.2 * uSpectrum.y + 0.8 * uLayers.y;
    float speed = length(velocity);
    if (speed > maximumSpeed) {
        velocity *= maximumSpeed / speed;
    }
    position += velocity * deltaTime;
    life += deltaTime * (0.020 + 0.025 * hash11(seed + 5.0));

    if (life >= 1.0 || length(position) > 9.5 || any(isnan(position))) {
        float generation = floor(uTime.x * 3.0) + float(index) * 0.001;
        vec3 randomPoint = hash31(seed + generation) * 2.0 - 1.0;
        randomPoint = normalize(randomPoint + vec3(0.0001));
        float cloudRadius = pow(hash11(seed + generation + 9.0),
            mix(2.2, 0.72, uSpatial.y)) * mix(2.2, 4.1, uMusic.x);
        float sourceMix = hash11(seed + 3.0);
        vec3 source = mix(uAttractor0.xyz, uAttractor1.xyz, sourceMix);
        source = mix(source, uAttractor2.xyz, uLayers.y * hash11(seed + 31.0));
        position = source * 0.28 + randomPoint * cloudRadius;
        position.x += uSpatial.x * 0.55;
        velocity = curlField(position, uTime.x + seed) *
            (0.12 + 0.35 * uMusic.x);
        life = 0.0;
    }

    nextParticles[index].position_life = vec4(position, life);
    nextParticles[index].velocity_seed = vec4(velocity, seed);
}
