{
  "python.useEnvironmentsExtension": true,
  "python-envs.alwaysUseUv": true,
  "python-envs.workspaceSearchPaths": [".venv"],
  "python-envs.terminal.autoActivationType": "command",

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [],
  "python.testing.cwd": "${workspaceFolder}",
  "python.testing.autoTestDiscoverOnSaveEnabled": true,
  "python.testing.promptToConfigure": false,

  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.languageServerMode": "full",
  "python.analysis.exclude": [
    "**/build/**",
    "**/dist/**"
  ],

  "python.analysis.indexing": true,
  "python.analysis.autoImportCompletions": true,
  "python.analysis.inlayHints.variableTypes": true,
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.pytestParameters": true,

  "python.analysis.completeFunctionParens": true,

  "python.analysis.enableEditableInstalls": true,

  "mypy-type-checker.path": ["uv", "run", "mypy"],
  "mypy-type-checker.importStrategy": "fromEnvironment",
  "mypy-type-checker.args": ["--config-file=${workspaceFolder}/pyproject.toml"],
  "mypy-type-checker.cwd": "${workspaceFolder}",
  "mypy-type-checker.reportingScope": "custom",
  "mypy-type-checker.preferDaemon": false,

  "ruff.nativeServer": "on",
  "ruff.importStrategy": "fromEnvironment",
  "ruff.configurationPreference": "filesystemFirst",
  "ruff.format.backend": "internal",

  "rumdl.configPath": "pyproject.toml",
  "markdownlint.appliesTo": "noFiles",

  "chatgpt.commentCodeLensEnabled": true,
  "chatgpt.followUpQueueMode": "queue",

  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/.*_cache": true,
    "**/.*-cache": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/__pycache__": true,
    "**/build": true
  },

  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "editor.rulers": [88],
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 7,

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },

  "[markdown]": {
    "editor.tabSize": 2,
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 88,
    "editor.codeActionsOnSave": {
      "source.fixAll.rumdl": "explicit"
    },
    "files.trimTrailingWhitespace": false
  },

  "[css][html][javascript][json][jsonc][yaml]": {
    "editor.tabSize": 2
  },
  "python.defaultInterpreterPath": "/Users/johng/Projects/iOpenPod/.venv/bin/python"
}
