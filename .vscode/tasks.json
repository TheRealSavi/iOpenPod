{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Environment: Sync dependencies",
      "type": "shell",
      "command": "uv",
      "args": [
        "sync",
        "--locked"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Typing: Prepare Qt",
      "type": "shell",
      "command": "uv",
      "args": ["run", "--locked", "python", "scripts/prepare_qt_typing.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Environment: Sync",
      "dependsOrder": "sequence",
      "dependsOn": ["Environment: Sync dependencies", "Typing: Prepare Qt"],
      "problemMatcher": []
    },
    {
      "label": "Check: Lockfile",
      "type": "shell",
      "command": "uv",
      "args": [
        "lock",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Format: Python",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "ruff",
        "format",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Fix: Python",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "ruff",
        "check",
        "--fix",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Format: Markdown",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "rumdl",
        "fmt",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Check: Formatting",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "ruff",
        "format",
        "--check",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Lint: Ruff",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "ruff",
        "check",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Lint: Markdown",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "rumdl",
        "check",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Typecheck: Mypy",
      "dependsOn": ["Typing: Prepare Qt"],
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "mypy",
        "--config-file=pyproject.toml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Test: Pytest",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "pytest"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Format: All",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Fix: Python",
        "Format: Python",
        "Format: Markdown"
      ],
      "problemMatcher": []
    },
    {
      "label": "Check: All",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Check: Lockfile",
        "Check: Formatting",
        "Lint: Ruff",
        "Lint: Markdown",
        "Typecheck: Mypy",
        "Test: Pytest"
      ],
      "problemMatcher": []
    }
  ]
}
